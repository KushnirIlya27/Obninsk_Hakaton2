+        profile.refresh_from_db()
+        self.stdout.write(f"Запрос на значок за 20 койнов; остаток {profile.balance}.")
+        try:
+            review_activity(
+                coordinator=coordinator,
+                activity_id=activity.pk,
+                decision="approved",
+                hours=3,
+            )
+        except Conflict as exc:
