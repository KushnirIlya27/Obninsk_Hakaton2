+        )
+
+    def test_csrf_login_and_writes(self):
+        client = Client(enforce_csrf_checks=True)
+        payload = {"username": "volunteer", "password": "test-password"}
+        self.assertEqual(
+            client.post(
+                "/api/auth/login/", payload, content_type="application/json"
+            ).status_code,
